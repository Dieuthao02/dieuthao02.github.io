/* ================= RESET ================= */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: "Playfair Display", serif;
    background:#f4f3f1;
    color:#2b2b2b;
}

/* WRAP */
#wrap{
    width:1200px;
    margin:40px auto;
    background:#fff;
    border-radius:14px;
    box-shadow:0 25px 70px rgba(0,0,0,.12);
    overflow:hidden;
}

/* ================= HEADER ================= */

#header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 40px;
    background:#1f1f1f;
}

#logo img{
    height:70px;
    border-radius:8px;
    transition:.4s;
    filter:grayscale(.2) contrast(1.1);
}
#logo img:hover{ transform:scale(1.05); }

/* MENU */

#menu_top ul{
    list-style:none;
    display:flex;
    gap:35px;
}

#menu_top a{
    text-decoration:none;
    color:#e8e6e3;
    font-weight:500;
    letter-spacing:.5px;
    position:relative;
    padding-bottom:4px;
}

#menu_top a::after{
    content:"";
    position:absolute;
    left:0;
    bottom:-6px;
    width:0;
    height:2px;
    background:#c9a96e;
    transition:.35s;
}

#menu_top a:hover::after{ width:100%; }
#menu_top a:hover{ color:#c9a96e; }

/* DROPDOWN */
.dropdown{ position:relative; }

.level2{
    position:absolute;
    top:40px;
    left:0;
    background:#ffffff;
    min-width:180px;
    border-radius:10px;
    box-shadow:0 15px 35px rgba(0,0,0,.2);
    opacity:0;
    transform:translateY(10px);
    pointer-events:none;
    transition:.35s;
}

.dropdown:hover .level2{
    opacity:1;
    transform:translateY(0);
    pointer-events:auto;
}

.level2 a{
    display:block;
    padding:10px 18px;
    color:#444 !important;
}
.level2 a:hover{
    background:#f2eee7;
    color:#000 !important;
}

/* ================= WELCOME ================= */

#welcome{
    text-align:center;
    padding:14px;
    background:#f2eee7;
    font-weight:500;
    letter-spacing:1px;
    border-bottom:1px solid #e0dbd2;
}

/* ================= 3 COLUMN LAYOUT ================= */

#center_content{
    display:grid;
    grid-template-columns:2.2fr 1.2fr 1.2fr;
    gap:25px;
    padding:30px;
}

/* LEFT */
#left{ grid-column:1; }

/* RIGHT becomes 2 columns */
#right{
    display:contents;
}

/* TITLES */
.title{
    font-size:20px;
    margin-bottom:18px;
    color:#1f1f1f;
    border-bottom:1px solid #ddd6c8;
    padding-bottom:8px;
    font-weight:600;
}

/* ================= PRODUCT CARD ================= */

.product {
    animation: fadeUp .6s ease both;
    position: relative;
    overflow: hidden;
    display: flex;
    gap: 18px;
    padding: 14px;
    margin-bottom: 18px;
    border-radius: 12px;
    background: #fcfbf9;
    border: 1px solid #ece7df;
    transition: .35s;
}

.product:hover {
    box-shadow: 
        0 10px 25px rgba(0,0,0,.12), 
        0 0 0 1px rgba(201,169,110,.25);
    transform: translateY(-5px);
}

.product img {
    border-radius: 10px; 
    transition: transform .5s cubic-bezier(.2, .8, .2, 1); 
}

.product:hover img {
    transform: scale(1.18); 
}

.name{
    color:#1f1f1f;
    font-size:18px;
    margin-bottom:5px;
}

.about{
    color:#666;
    font-size:14px;
    line-height:1.5;
}

/* ================= PROMOTION (SMALLER) ================= */

#promotion{
    grid-column:2;
    background:#fbfaf7;
    border:1px solid #e8e2d8;
    padding:16px;
    border-radius:12px;
    height:fit-content;
}

.product_small{
    display:flex;
    align-items:center;
    gap:12px;
    margin:12px 0;
    padding:8px;
    border-radius:10px;
    transition:.3s;
}

.product_small img{
    width:65px;
    height:65px;
    object-fit:cover;
    border-radius:8px;
}

.product_small:hover {
  
    background: #f5f2ec;     
    border: 1px solid #e6dfd4; 
    transform: translateX(5px); 
}

.product_small .name{
    font-size:14px;
}

/* ================= CATALOG & INTERACTION (MERGED) ================= */

#categories {
    grid-column: 3;
    background: #fbfaf7;
    border: 1px solid #e8e2d8;
    padding: 16px;
    border-radius: 12px;
}

.menu_right {
    list-style: none;
}

.menu_right li {
    border-bottom: 1px solid #eee6db;
}

.menu_right a {
    display: block;
    padding: 10px;
    color: #333;
    text-decoration: none;
    transition: .25s;
    position: relative; 
}

.menu_right a::after {
    content: "›";
    position: absolute;
    right: 12px;
    opacity: 0;
    transition: .3s;
}

.menu_right a:hover {
    padding-left: 18px;
    color: #c9a96e;
}

.menu_right a:hover::after {
    opacity: 1;
    right: 6px;
}

/* ================= FOOTER ================= */

#footer{
    display:flex;
    justify-content:space-between;
    padding:22px 40px;
    background:#1f1f1f;
    color:#d6d3cd;
    font-size:14px;
}

/* ================= PRODUCT PRICE ================= */

/* fake price */
.product:nth-child(4)::after{
    content:"$30";
}
.product:nth-child(2)::after{
    content:"$25";
}
.product:nth-child(3)::after{
    content:"$25";
}

.product::after{
    position:absolute;
    right:18px;
    bottom:14px;
    font-weight:600;
    color:#c9a96e;
    font-size:18px;
    letter-spacing:.5px;
}

/* ================= BADGES ================= */


.product::before{
    position:absolute;
    top:12px;
    left:-40px;
    background:#c9a96e;
    color:#fff;
    font-size:12px;
    padding:4px 45px;
    transform:rotate(-45deg);
    font-weight:600;
    letter-spacing:1px;
}

/* ================= QUICK VIEW OVERLAY ================= */

.product .img{
    position:relative;
    overflow:hidden;
}

.product .img::after{
    content:"Quick View";
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(0,0,0,.45);
    color:white;
    font-size:14px;
    letter-spacing:1px;
    opacity:0;
    transition:.35s;
}

.product:hover .img::after{
    opacity:1;
}

/* ================= ADD TO CART BUTTON ================= */

.product .description{
    position:relative;
}

.product .fake-btn{
    display:inline-block;
    margin-top:10px;
    padding:8px 14px;
    border:1px solid #c9a96e;
    color:#c9a96e;
    font-size:13px;
    letter-spacing:.5px;
    cursor:pointer;
    transition:.3s;
}

.product:hover .fake-btn{
    background:#c9a96e;
    color:white;
}


/* ================= PROMOTION MINI SHOP ITEM ================= */

.product_small{
    border:1px solid transparent;
}

.product_small::after{
    content:"$19";
    margin-left:auto;
    font-size:13px;
    color:#c9a96e;
    font-weight:600;
}


/* ================= LUXURY MICRO ANIMATION ================= */

@keyframes fadeUp{
    from{
        opacity:0;
        transform:translateY(15px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}


.product:nth-child(2){ animation-delay:.1s; }
.product:nth-child(3){ animation-delay:.2s; }


/* CART ICON */
#cart-icon{
    color:#e8e6e3;
    font-size:18px;
    cursor:pointer;
    position:relative;
}

#cart-count{
    background:#c9a96e;
    color:#fff;
    border-radius:50%;
    padding:2px 7px;
    font-size:12px;
    margin-left:4px;
}

/* PANEL */
#cart-panel {
    position: fixed;
    right: -400px;        
    top: 0;
    width: 350px;        
    height: 100%;
    background: #071312;    
    color: white;          
    box-shadow: -5px 0 30px rgba(0,0,0,0.5);
    transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94); 
    z-index: 9999;         
    padding: 25px;         
    display: flex;       
    flex-direction: column; 
    overflow-y: auto; 
}

#cart-panel.open{ right:0; }

.cart-item {
    display: flex;
    gap: 15px;              
    margin-bottom: 20px;   
    background: rgba(255,255,255,0.05);
    padding: 10px;
    border-radius: 10px;
    align-items: center; 
}

.cart-item img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 5px; 
}

.total{
    margin-top:20px;
    border-top:1px solid #ddd;
    padding-top:10px;
}

/* POPUP */
.cart-popup{
    position:fixed;
    bottom:30px;
    right:30px;
    background:#1f1f1f;
    color:white;
    padding:12px 18px;
    border-radius:10px;
    opacity:0;
    transform:translateY(20px);
    transition:.4s;
}

.cart-popup.show{
    opacity:1;
    transform:translateY(0);
}

/* qty buttons */
.qty{
    display:flex;
    align-items:center;
    gap:8px;
    margin:6px 0;
}

.qty button{
    width:22px;
    height:22px;
    border:1px solid #c9a96e;
    background:white;
    cursor:pointer;
}

.qty button:hover{
    background:#c9a96e;
    color:white;
}

.remove{
    background:none;
    border:none;
    color:#999;
    cursor:pointer;
    font-size:12px;
}

.remove:hover{ color:#000; }

#checkout{
    width:100%;
    padding:12px;
    margin-top:15px;
    background:#1f1f1f;
    color:white;
    border:none;
    cursor:pointer;
}

#checkout:hover{
    background:#c9a96e;
}


#close-cart{
    cursor:pointer;
    font-size:22px;
    line-height:1;
    width:32px;
    height:32px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    transition:.25s;
}

#close-cart:hover{
    background:rgba(255,255,255,.12);
    transform:rotate(90deg);
}


@keyframes shake-cart {
    0% { transform: rotate(0); }
    25% { transform: rotate(15deg); }
    50% { transform: rotate(-15deg); }
    75% { transform: rotate(10deg); }
    100% { transform: rotate(0); }
}

.cart-shake {
    animation: shake-cart 0.4s ease-in-out;
}


.cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15px; 
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
}

#invoice-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85); 
    z-index: 10000;
    backdrop-filter: blur(8px);     
    overflow-y: auto;               
    padding: 40px 10px;          
    align-items: center;
    justify-content: center;
}

.invoice-box {
    background: white;
    color: #333;
    padding: 30px;               
    width: 95%;                 
    max-width: 450px;         
    margin: auto;                 
    border-radius: 15px;         
    box-shadow: 0 10px 50px rgba(0,0,0,0.5); 
    position: relative;
    display: flex;
    flex-direction: column;

}

.invoice-box h2 { color: #c9a96e; text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; }

#checkout-btn {
    background: #c9a96e;
    color: white;
    border: none;
    padding: 15px;
    width: 100%;
    font-weight: bold;
    cursor: pointer;
    margin-top: auto;
}


.invoice-header-block {
    text-align: center;
    margin: 0; 
    padding: 10px 0; 
}


.invoice-box img {
    min-height: 200px;
    background: url('https://i.gifer.com/ZKZg.gif') center no-repeat;
    background-size: 30px;
}


#invoice-modal button:first-child {
    background: linear-gradient(90deg, #1f1f1f, #333);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}


@media print {
    #qr-to-zoom, 
    .no-print, 
    .qr-instruction,
    #close-cart, 
    button, 
    .fake-btn { 
        display: none !important; 
    }

    .invoice-box {
        box-shadow: none !important;
        border: none !important;
    }

    body * {
        visibility: hidden;
    }

    #invoice-modal, 
    #invoice-modal #printable-invoice, 
    #invoice-modal #printable-invoice * {
        visibility: visible;
    }

    #invoice-modal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        background: white !important;
        display: block !important;
    }

    #printable-invoice {
        position: relative;
        margin: 0 auto;
        padding: 0;
        width: 100%;
        box-shadow: none !important;
    }

    .qr-image {
        width: 150px !important;
        height: 150px !important;
    }
}

.qr-image {
    width: 180px; 
    height: 180px; 
    object-fit: contain; 
    cursor: zoom-in;
    transition: transform 0.3s ease;
    border: 1px solid #eee;
    padding: 5px;
    background: #fff;
}

.qr-image.zoomed {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(2.5); 
    z-index: 10001;
    box-shadow: 0 0 100px rgba(0,0,0,0.8);
    cursor: zoom-out;
    max-height: 80vh; 
}

.qr-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 10000;
}
.qr-overlay.show { display: block; }

